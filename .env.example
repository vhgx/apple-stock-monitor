# Configurações do Monitor Apple Store
# Renomeie este arquivo para .env e preencha suas credenciais

# Produto a monitorar
# MK1G4LL/A = iPhone Duo 512GB Star White (Unlocked/US)
PART_NUMBER=MK1G4LL/A
PRODUCT_NAME=iPhone Duo 512GB Star White
ZIP_CODE=10001

# Configurações de E-mail (Outlook / Live / Hotmail)
SMTP_SERVER=smtp-mail.outlook.com
SMTP_PORT=587
EMAIL_SENDER=seu_email@exemplo.com
EMAIL_PASSWORD=sua_senha_de_app_microsoft
EMAIL_RECEIVER=seu_email@exemplo.com

# Intervalo entre checagens em modo contínuo (minutos)
CHECK_INTERVAL_MINUTES=5
